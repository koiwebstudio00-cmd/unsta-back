# Copiar valores usando npm run demo:setup; genera .env.local ignorado por Git.
DATABASE_URL=postgresql://unsta_rt:REEMPLAZAR@127.0.0.1:55432/unsta_demo
MIGRATION_DATABASE_URL=postgresql://unsta_owner:REEMPLAZAR@127.0.0.1:55432/unsta_demo
POSTGRES_PASSWORD=REEMPLAZAR
RUNTIME_DB_PASSWORD=REEMPLAZAR
AGENT_SERVICE_KEY=REEMPLAZAR
N8N_WEBHOOK_KEY=REEMPLAZAR
# Vacío: no despachar. Configurar recién después de importar los workflows.
N8N_CONVERSATION_URL=
N8N_OPENING_URL=
PORT=4100
HOST=127.0.0.1
PANEL_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Debe ser true para arrancar el worker de envíos (por defecto apagado).
DISPATCH_ENABLED=false
# Todos los accesos comparten este espacio. En instalaciones existentes usar el UUID con los datos.
UNSTA_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
